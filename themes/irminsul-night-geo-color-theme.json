  "tokenColors": [
    {
      "name": "Comments (a whisper in the margin)",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#7B83A1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Electro: keywords that steer (if, for, return, import)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.other.special-method",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#B18BEC"
      }
    },
    {
      "name": "Electro, deeper: keywords that create (def, class, const, let)",
      "scope": [
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "storage.type.function",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#9479D9"
      }
    },
    {
      "name": "Async and await go italic",
      "scope": [
        "storage.modifier.async",
        "storage.type.function.async",
        "keyword.control.flow.await",
        "keyword.control.await",
        "keyword.operator.await"
      ],
      "settings": {
        "foreground": "#9479D9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Geo: functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "entity.name.method",
        "support.function.builtin",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#F2C463"
      }
    },
    {
      "name": "Dendro: strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#A8D04A"
      }
    },
    {
      "name": "Pyro: numbers & constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "keyword.other.unit",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#FF8A5C"
      }
    },
    {
      "name": "Hydro: types & classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "entity.name.tag",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#5CC4F5"
      }
    },
    {
      "name": "Cryo: properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.property-name",
        "support.type.property-name",
        "entity.other.attribute-name",
        "variable.parameter",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#9FE0F0"
      }
    },
    {
      "name": "Anemo: decorators & special",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator",
        "punctuation.definition.template-expression",
        "variable.other.constant.property",
        "variable.css",
        "variable.scss",
        "entity.other.attribute-name.pseudo-class",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#5FD3AE"
      }
    },
    {
      "name": "Operators & punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#C9BFA9"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E4DDCD"
      }
    },
    {
      "name": "Object keys ({ name: 1 })",
      "scope": [
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#9FE0F0"
      }
    },
    {
      "name": "Fenced code: the language name and the backticks",
      "scope": [
        "fenced_code.block.language",
        "punctuation.definition.markdown"
      ],
      "settings": {
        "foreground": "#5FD3AE"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#F7D99A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown ## in Hydro",
      "scope": [
        "heading.2.markdown",
        "heading.2.markdown entity.name.section",
        "heading.2.markdown punctuation.definition.heading",
        "markup.heading.2"
      ],
      "settings": {
        "foreground": "#5CC4F5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown ### in Anemo",
      "scope": [
        "heading.3.markdown",
        "heading.3.markdown entity.name.section",
        "heading.3.markdown punctuation.definition.heading",
        "markup.heading.3"
      ],
      "settings": {
        "foreground": "#5FD3AE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown #### and deeper in Cryo",
      "scope": [
        "heading.4.markdown",
        "heading.5.markdown",
        "heading.6.markdown",
        "heading.4.markdown entity.name.section",
        "heading.5.markdown entity.name.section",
        "heading.6.markdown entity.name.section"
      ],
      "settings": {
        "foreground": "#9FE0F0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold / italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F2C463",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#B18BEC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#5CC4F5"
      }
    },
    {
      "name": "Markdown quotes & lists",
      "scope": [
        "markup.quote",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#5FD3AE"
      }
    },
    {
      "name": "Diff added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#A8D04A"
      }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF8A5C"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#F2C463"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF6B6B"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#5CC4F5",
